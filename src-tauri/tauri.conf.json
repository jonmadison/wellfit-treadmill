{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WELLFIT TM",
  "version": "0.1.0",
  "identifier": "dev.local.wellfit-tm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WELLFIT TM",
        "width": 340,
        "height": 620,
        "minWidth": 300,
        "minHeight": 420,
        "alwaysOnTop": true,
        "resizable": true,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
